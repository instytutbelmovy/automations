# Скапіяваць у /opt/corpus/.env і запоўніць.
# Гэты файл чытаюць і docker compose, і provision.sh.

# ECR рэгістр і рэпазыторый - глядзіце Outputs стэка corpus-build-prod
# (NoskeRepositoryUri), напр. 123456789012.dkr.ecr.eu-central-1.amazonaws.com
ECR_REGISTRY=<account-id>.dkr.ecr.eu-central-1.amazonaws.com
ECR_REPOSITORY=instytutbelmovy-noske-prod

# Дамэн, які праксіруе Cloudflare
DOMAIN=noske.bielkorpus.com

# Рэгіён AWS (для credential helper'а)
AWS_REGION=eu-central-1
